generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model chats {
  id          String     @id @default(uuid())
  name        String
  user_id     String
  document_id String     @unique
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  documents   documents  @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages    messages[]
}

model documents {
  id            String   @id @default(uuid())
  title         String
  is_vectorized Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  chats         chats?
}

model messages {
  id         String   @id @default(uuid())
  chat_id    String
  role       String
  content    String
  is_summary Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  chats      chats    @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  kinde_user_id String   @unique
  avatar_url    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  chats         chats[]
}
