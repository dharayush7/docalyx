generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model chats {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(255)
  user_id     String     @db.Uuid
  document_id String     @unique @db.Uuid
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  documents   documents  @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages    messages[]

  @@index([user_id], map: "ix_chats_user_id")
}

model documents {
  id            String   @id @default(uuid()) @db.Uuid
  title         String   @db.VarChar(255)
  is_vectorized Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  chats         chats?

  @@index([is_vectorized], map: "ix_documents_vectorized")
}

model messages {
  id         String       @id @default(uuid()) @db.Uuid
  chat_id    String       @db.Uuid
  role       message_role
  content    String
  is_summary Boolean      @default(false)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @default(now()) @db.Timestamptz(6)
  chats      chats        @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chat_id], map: "ix_messages_chat_id")
  @@index([chat_id, is_summary], map: "ix_messages_chat_summary")
}

model users {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  email         String   @unique(map: "ix_users_email") @db.VarChar(255)
  kinde_user_id String   @unique @db.VarChar(255)
  avatar_url    String?  @db.VarChar(500)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  chats         chats[]
}

enum message_role {
  user
  assistant
  system
}
