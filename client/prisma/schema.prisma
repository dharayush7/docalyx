generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model chats {
  id         String     @id @db.Uuid
  name       String     @db.VarChar(255)
  user_id    String     @db.VarChar(36)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  users      users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  documents  documents?
  messages   messages[]

  @@index([user_id], map: "ix_chats_user_id")
}

model documents {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(255)
  chat_id       String   @unique @db.Uuid
  is_vectorized Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  chats         chats    @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model messages {
  id         String   @id @db.Uuid
  chat_id    String   @db.Uuid
  role       String   @db.VarChar
  content    String
  is_summary Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  chats      chats    @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chat_id], map: "ix_messages_chat_id")
}

model users {
  id            String   @id
  name          String
  email         String   @unique
  kinde_user_id String   @unique
  avatar_url    String?
  created_at    DateTime @default(now())
  updated_at    DateTime
  chats         chats[]
}
